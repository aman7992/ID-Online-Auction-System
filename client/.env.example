# ID Online Auction System - Frontend Environment Configuration
# Rename this file to .env.local for local overrides or configure in your deployment dashboard

# Backend REST API base URL (Render deployed backend)
# In development, leave blank or omit to use the local Vite reverse proxy (/api -> localhost:5000)
VITE_API_URL=https://id-online-auction-system.onrender.com

# Optional: Dedicated WebSocket server URL (defaults to VITE_API_URL without /api if omitted)
VITE_SOCKET_URL=https://id-online-auction-system.onrender.com
